<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SpaRoot>..\NestHub.Web\</SpaRoot>
    <SpaDist>$(SpaRoot)dist\</SpaDist>
    <FrontendWwwRoot>$(MSBuildProjectDirectory)\wwwroot\</FrontendWwwRoot>
    <NpmCommand Condition="'$(OS)' == 'Windows_NT'">npm.cmd</NpmCommand>
    <NpmCommand Condition="'$(OS)' != 'Windows_NT'">npm</NpmCommand>
    <SkipFrontendBuild Condition="'$(SkipFrontendBuild)' == ''">false</SkipFrontendBuild>
    <BrowserExtensionRoot>$(MSBuildProjectDirectory)/../../extensions/nesthub/</BrowserExtensionRoot>
    <BrowserExtensionArchive>$(FrontendWwwRoot)downloads/nesthub-extension.zip</BrowserExtensionArchive>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="publish\**" />
    <Content Remove="publish\**" />
    <EmbeddedResource Remove="publish\**" />
    <None Remove="publish\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FreeSql.Provider.MySqlConnector" Version="3.5.309" />
    <PackageReference Include="MailKit" Version="4.16.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.6" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
  </ItemGroup>

  <Target Name="BuildFrontendAssets" BeforeTargets="PrepareForBuild;ResolveProjectStaticWebAssets" Condition="'$(SkipFrontendBuild)' != 'true'">
    <Message Text="Building NestHub.Web and syncing files into wwwroot..." Importance="high" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="$(NpmCommand) ci" Condition="!Exists('$(SpaRoot)node_modules')" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="$(NpmCommand) run build" />
    <RemoveDir Directories="$(FrontendWwwRoot)" Condition="Exists('$(FrontendWwwRoot)')" />
    <MakeDir Directories="$(FrontendWwwRoot)" />
    <ItemGroup>
      <FrontendDistFiles Include="$(SpaDist)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(FrontendDistFiles)" DestinationFiles="@(FrontendDistFiles->'$(FrontendWwwRoot)%(RecursiveDir)%(Filename)%(Extension)')" />
    <ItemGroup>
      <Content Remove="wwwroot\**" />
      <Content Include="wwwroot\**\*" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <Target Name="BuildBrowserExtension" BeforeTargets="ResolveProjectStaticWebAssets;AssignTargetPaths" DependsOnTargets="BuildFrontendAssets">
    <MakeDir Directories="$(FrontendWwwRoot)downloads" />
    <ZipDirectory SourceDirectory="$(BrowserExtensionRoot)" DestinationFile="$(BrowserExtensionArchive)" Overwrite="true" />
    <ItemGroup>
      <Content Remove="wwwroot\downloads\nesthub-extension.zip" />
      <Content Include="wwwroot\downloads\nesthub-extension.zip" CopyToPublishDirectory="Always" />
    </ItemGroup>
  </Target>

  <!-- Explicit inclusion also covers the first publish, before wwwroot exists at evaluation time. -->
  <Target Name="PublishBrowserExtension" BeforeTargets="ComputeFilesToPublish" DependsOnTargets="BuildBrowserExtension">
    <ItemGroup>
      <ResolvedFileToPublish Remove="$(BrowserExtensionArchive)" />
      <ResolvedFileToPublish Include="$(BrowserExtensionArchive)">
        <RelativePath>wwwroot/downloads/nesthub-extension.zip</RelativePath>
        <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
