# Run bash scripts/deploy.sh to generate real passwords automatically.
NESTHUB_IMAGE=ghcr.io/sunnyfancore/nesthub:latest
NESTHUB_BIND_ADDRESS=0.0.0.0
NESTHUB_PORT=5186
TZ=Asia/Shanghai
# Backend update service token: generate with openssl rand -hex 32.
UPDATE_API_TOKEN=replace-with-a-random-update-token
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Only needed for docker-compose.mysql.yml. Use letters/numbers for database passwords (avoid ; and $ in connection strings).
MYSQL_PASSWORD=replace-with-random-alphanumeric-password
MYSQL_ROOT_PASSWORD=replace-with-another-random-alphanumeric-password
